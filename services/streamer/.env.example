# Junpa Streamer Configuration
# Copy this file to .env and fill in the values

# Application
JUNPA_APP_NAME=Junpa Streamer
JUNPA_DEBUG=true
JUNPA_LOG_LEVEL=DEBUG

# Server
JUNPA_HOST=0.0.0.0
JUNPA_PORT=8000

# Google OAuth (required)
JUNPA_GOOGLE_CLIENT_ID=your-google-client-id
JUNPA_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Security (change in production!)
JUNPA_JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-key
JUNPA_JWT_ALGORITHM=HS256
JUNPA_STREAM_URL_EXPIRY_SECONDS=86400

# HLS Settings
JUNPA_HLS_SEGMENT_DURATION=6
JUNPA_HLS_PLAYLIST_SIZE=5

# Caching
JUNPA_LIBRARY_CACHE_TTL=60
JUNPA_SEGMENT_CACHE_TTL=300

# CORS (comma-separated origins)
JUNPA_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
